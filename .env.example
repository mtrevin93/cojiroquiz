# Copy to .env (never committed)
ANTHROPIC_API_KEY=
PARSE_MODEL=claude-haiku-5-5
RESEND_API_KEY=
FEEDBACK_TO=
FEEDBACK_FROM=feedback@cojiroquiz.com
ADMIN_TOKEN=
IP_HASH_SALT=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
