BUCKET_PRIVATE=cojiroquiz-quarantine
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# Key for the private bucket, when it differs from the one above
PRIVATE_AWS_ACCESS_KEY_ID=
PRIVATE_AWS_SECRET_ACCESS_KEY=
PUBLIC_IMAGE_BASE_URL=
