---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
---

<Base title="Not found" noindex>
  <div class="wrap narrow prose">
    <h1>Not found</h1>
    <p>There is nothing at this address. The question may have been removed or hidden.</p>
    <p><a class="btn" href="/">Search all questions</a></p>
  </div>
</Base>
