---
import Base from '../layouts/Base.astro';
---

<Base
  title="About"
  description="About Cojiro Quiz, an unofficial answer key for the Zelda Notes Ocarina of Time quiz."
>
  <div class="wrap about">
    <h1>About</h1>
    <p class="about-lede">Answers to the Ocarina of Time quiz in Zelda Notes, added by players.</p>
    <dl class="about-list">
      <div>
        <dt>Add a question</dt>
        <dd>
          <a href="/upload">Upload</a> a screenshot of the question. The result screen is best: it shows the correct
          answer. No screenshot? Type it in.
        </dd>
      </div>
      <div>
        <dt>Wrong answer</dt>
        <dd>Use “Report a problem” on the question's page.</dd>
      </div>
      <div>
        <dt>Privacy</dt>
        <dd>
          No accounts, no tracking. A salted hash of your IP address is kept with uploads and reports to limit abuse.
          Uploaded screenshots are public.
        </dd>
      </div>
      <div>
        <dt>Unofficial</dt>
        <dd>
          Fan project, not affiliated with Nintendo. The Legend of Zelda and Ocarina of Time are trademarks of
          Nintendo.
        </dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>Use Feedback at the bottom of the page.</dd>
      </div>
    </dl>
  </div>
</Base>
