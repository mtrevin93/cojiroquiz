---
import Base from '../layouts/Base.astro';
---

<Base
  title="About"
  description="Cojiro Quiz is an unofficial answer key and cheat sheet for the Ocarina of Time Quiz in Zelda Notes."
>
  <div class="wrap about">
    <h1>About</h1>
    <p class="about-lede">
      An answer key for the Ocarina of Time Quiz in Zelda Notes, the companion to the Switch 2 remake. Covers Egg
      Level, Cucco Level and Cojiro Challenge questions, added by players.
    </p>
    <dl class="about-list">
      <div>
        <dt>Add a question</dt>
        <dd>
          <a href="/upload">Upload</a> a screenshot of the question. The result screen is best: it shows the correct
          answer.
        </dd>
      </div>
      <div>
        <dt>Wrong answer</dt>
        <dd>Use “Report a problem” on the question's page.</dd>
      </div>
      <div>
        <dt>Privacy</dt>
        <dd>
          No accounts, no tracking. A salted hash of your IP address is kept with uploads and reports to limit abuse.
          Uploaded screenshots are public.
        </dd>
      </div>
      <div>
        <dt>Unofficial</dt>
        <dd>
          Fan project, not affiliated with Nintendo. The Legend of Zelda and Ocarina of Time are trademarks of
          Nintendo.
        </dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>Use Feedback at the bottom of the page.</dd>
      </div>
    </dl>
  </div>
</Base>
