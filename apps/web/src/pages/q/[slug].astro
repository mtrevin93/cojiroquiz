---
import { choiceText, getQuestionById, getQuestionBySlug } from '@cojiro/db';
import { CheckIcon } from '../../components/icons.tsx';
import { AnswerBox, QuestionText, questionPath } from '../../components/QuestionCard.tsx';
import ReportButton from '../../components/ReportButton.tsx';
import Base from '../../layouts/Base.astro';
import { isAdminRequest, pageContext } from '../../lib/page.ts';
import { answerWords, qaPageJsonLd } from '../../lib/seo.ts';
import { langName, oneLine } from '../../lib/text.ts';

const { db, urlFor, env } = await pageContext();
const slug = Astro.params.slug ?? '';
let q = getQuestionBySlug(db, urlFor, slug);
if (!q) {
  // Slugs change when an admin fixes the text; the leading id stays stable.
  const id = Number(/^(\d+)(?:-|$)/.exec(slug)?.[1]);
  const byId = Number.isSafeInteger(id) ? getQuestionById(db, urlFor, id) : null;
  if (byId && !byId.hidden) return Astro.redirect(questionPath(byId.slug), 301);
}
const admin = isAdminRequest(Astro.cookies);
if (!q || (q.hidden && !admin)) return Astro.rewrite('/404');

const answer = q.choices[q.answerIndex];
const answerText = choiceText(answer);
const pictureChoices = q.choices.length > 0 && q.choices.every((c) => c.imageUrl);
const wrong = q.choices.filter((_, i) => i !== q.answerIndex);
const allLabels = q.choices.map((c) => choiceText(c));
const short = oneLine(q.questionText, 70);
// A picture answer may have no name; the page then shows the picture marked as correct.
const named = answerText.trim() !== '';
const title = named ? `${short} Answer: ${oneLine(answerWords(answerText, allLabels), 30)}` : `${short} Answer`;
const description = named
  ? `Answer: ${answerWords(answerText, allLabels)}. Ocarina of Time Quiz (Zelda Notes) question: ${oneLine(q.questionText, 140)}`
  : `The answer, shown as a picture. Ocarina of Time Quiz (Zelda Notes) question: ${oneLine(q.questionText, 140)}`;
const ogImage = q.pictureUrl ?? q.answerImage?.url ?? q.questionImage?.url ?? null;
---

<Base
  title={title}
  description={description}
  canonicalPath={questionPath(q.slug)}
  noindex={q.hidden}
  ogImage={ogImage}
  ogType="article"
  jsonLd={q.hidden || !named ? [] : [qaPageJsonLd(env.siteUrl, q, answerText)]}
>
  <div class="wrap narrow qpage">
    <div class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">All questions</a>
      </nav>
      {q.hidden && (
        <div class="notice error">
          <p>This question is hidden from visitors. You are seeing it because you are signed in as admin.</p>
        </div>
      )}
    </div>

    <article class="qcard">
      <div class="qcard-body">
        {q.pictureUrl && (
          <img
            class="qcard-picture"
            src={q.pictureUrl}
            alt={q.pictureDescription ? `Picture shown with the question: ${q.pictureDescription}` : 'Picture shown with the question'}
            decoding="async"
          />
        )}
        <h1 class="qcard-text" lang={q.lang}><QuestionText text={q.questionText} /></h1>
      </div>
      <div class="qcard-foot">
        {pictureChoices && (
          <ul class="choice-pics" lang={q.lang}>
            {q.choices.map((c, i) => (
              <li class:list={[i === q.answerIndex && 'is-right']}>
                <img src={c.imageUrl!} alt={i === q.answerIndex ? `${choiceText(c)} (correct answer)` : choiceText(c)} loading="lazy" decoding="async" />
                {i === q.answerIndex && <span class="choice-pics-mark"><CheckIcon /></span>}
              </li>
            ))}
          </ul>
        )}
        <AnswerBox label={answerText} allLabels={allLabels} choiceImageUrl={null} lang={q.lang} />
        {q.disputed && (
          <div class="qcard-meta">
            <span class="tag disputed">Disputed</span>
            <span class="muted">Uploads or reports disagree on this answer.</span>
          </div>
        )}
        {!pictureChoices && wrong.length > 0 && (
          <div class="other-choices">
            <h2 class="section-label">Other choices</h2>
            <ul lang={q.lang}>
              {wrong.map((c) => <li>{answerWords(choiceText(c), allLabels)}</li>)}
            </ul>
          </div>
        )}
      </div>
    </article>

    {(q.submissionCount > 0 || q.lang !== 'en') && (
      <p class="qmeta">
        {q.submissionCount > 0 && <>{q.submissionCount} {q.submissionCount === 1 ? 'upload' : 'uploads'}</>}
        {q.answerSource === 'reveal' && ' · answer read from the result screen'}
        {q.lang !== 'en' && `${q.submissionCount > 0 ? ' · ' : ''}${langName(q.lang)}`}
        {q.answerImage && <> · <a href={q.answerImage.url}>result screenshot</a></>}
      </p>
    )}

    <div class="report-row">
      <ReportButton client:idle questionId={q.id} />
    </div>
  </div>
</Base>
