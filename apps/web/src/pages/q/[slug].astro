---
import { choiceText, getQuestionById, getQuestionBySlug } from '@cojiro/db';
import { CheckIcon } from '../../components/icons.tsx';
import { AnswerBox, QuestionText, questionPath } from '../../components/QuestionCard.tsx';
import ReportButton from '../../components/ReportButton.tsx';
import Base from '../../layouts/Base.astro';
import { isAdminRequest, pageContext } from '../../lib/page.ts';
import { qaPageJsonLd } from '../../lib/seo.ts';
import { langName, oneLine } from '../../lib/text.ts';

const { db, urlFor, env } = await pageContext();
const slug = Astro.params.slug ?? '';
let q = getQuestionBySlug(db, urlFor, slug);
if (!q) {
  // Slugs change when an admin fixes the text; the leading id stays stable.
  const id = Number(/^(\d+)(?:-|$)/.exec(slug)?.[1]);
  const byId = Number.isSafeInteger(id) ? getQuestionById(db, urlFor, id) : null;
  if (byId && !byId.hidden) return Astro.redirect(questionPath(byId.slug), 301);
}
const admin = isAdminRequest(Astro.cookies);
if (!q || (q.hidden && !admin)) return Astro.rewrite('/404');

const answer = q.choices[q.answerIndex];
const answerText = choiceText(answer);
const short = oneLine(q.questionText, 70);
const title = `${short} Answer: ${oneLine(answerText, 30)}`;
const description = `Answer: ${answerText}. Quiz question: ${oneLine(q.questionText, 150)}`;
const ogImage = q.answerImage?.url ?? q.questionImage?.url ?? null;
---

<Base
  title={title}
  description={description}
  canonicalPath={questionPath(q.slug)}
  noindex={q.hidden}
  ogImage={ogImage}
  ogType="article"
  jsonLd={q.hidden ? [] : [qaPageJsonLd(env.siteUrl, q, answerText)]}
>
  <div class="wrap narrow qpage">
    <div class="page-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">All questions</a>
      </nav>
      {q.hidden && (
        <div class="notice error">
          <p>This question is hidden from visitors. You are seeing it because you are signed in as admin.</p>
        </div>
      )}
    </div>

    <article class="qcard">
      <div class="qcard-body">
        <h1 class="qcard-text" lang={q.lang}><QuestionText text={q.questionText} /></h1>
      </div>
      <div class="qcard-foot">
        <AnswerBox label={answerText} choiceImageUrl={answer?.imageUrl ?? null} lang={q.lang} />
        {q.disputed && (
          <div class="qcard-meta">
            <span class="tag disputed">Disputed answer</span>
            <span class="muted">Uploads or reports disagree on this answer.</span>
          </div>
        )}
        <h2 class="section-label">All choices</h2>
        <ol class="choices" lang={q.lang}>
          {q.choices.map((c, i) => {
            const right = i === q.answerIndex;
            return (
              <li class:list={['choice', 'ornate', right ? 'is-right' : 'is-wrong']}>
                {right && <CheckIcon />}
                {c.imageUrl && (
                  <img class="choice-img" src={c.imageUrl} alt={c.description ?? c.label} width="72" height="72" loading="lazy" decoding="async" />
                )}
                <span>
                  {choiceText(c)}
                  {c.description && c.label && c.description !== c.label && <span class="choice-desc">{c.description}</span>}
                  {right && <span class="sr-only"> (correct answer)</span>}
                </span>
              </li>
            );
          })}
        </ol>
      </div>
    </article>

    <dl class="facts">
      <div><dt>Language</dt><dd>{langName(q.lang)}</dd></div>
      <div>
        <dt>Confirmations</dt>
        <dd>{q.submissionCount}</dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd>{q.answerSource === 'reveal' ? 'result screenshot' : 'uploader'}</dd>
      </div>
    </dl>

    {(q.answerImage || q.questionImage) && (
      <div class="shots">
        {q.questionImage && (
          <figure>
            <a href={q.questionImage.url}>
              <img
                src={q.questionImage.url}
                alt={`Screenshot of the quiz question: ${oneLine(q.questionText, 140)}`}
                width={q.questionImage.width || undefined}
                height={q.questionImage.height || undefined}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption>Question</figcaption>
          </figure>
        )}
        {q.answerImage && (
          <figure>
            <a href={q.answerImage.url}>
              <img
                src={q.answerImage.url}
                alt={`Screenshot of the result screen showing the correct answer “${answerText}” to: ${oneLine(q.questionText, 110)}`}
                width={q.answerImage.width || undefined}
                height={q.answerImage.height || undefined}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption>Result: gold marks the correct answer</figcaption>
          </figure>
        )}
      </div>
    )}

    <div class="report-row">
      <ReportButton client:visible questionId={q.id} />
    </div>
  </div>
</Base>
