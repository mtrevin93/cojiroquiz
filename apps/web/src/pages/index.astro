---
import { buildSearchIndex, filterEntries, listLanguages } from '@cojiro/db';
import SearchApp from '../components/SearchApp.tsx';
import Base from '../layouts/Base.astro';
import { pageContext, pickInitialLang } from '../lib/page.ts';
import { SITE_TAGLINE, websiteJsonLd } from '../lib/seo.ts';
import { oneLine } from '../lib/text.ts';

const { db, urlFor, env } = await pageContext();
const entries = buildSearchIndex(db, urlFor);
const languages = listLanguages(db);

const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 200);
const langParam = Astro.url.searchParams.get('lang');
const initialLang = pickInitialLang(
  langParam,
  Astro.request.headers.get('accept-language'),
  languages.map((l) => l.value),
);
const matchCount = q ? filterEntries(entries, q, initialLang || null).length : entries.length;

const title = q ? `“${oneLine(q, 40)}”: ${matchCount} ${matchCount === 1 ? 'answer' : 'answers'}` : undefined;
const description = `${SITE_TAGLINE}. Search ${entries.length} questions by any word.`;

// The default language comes from Accept-Language, so shared caches must not mix variants.
Astro.response.headers.set('Vary', 'Accept-Language');
---

<Base title={title} description={description} canonicalPath="/" noindex={q !== ''} jsonLd={[websiteJsonLd(env.siteUrl)]}>
  <div class="wrap">
    <h1 class="sr-only">Ocarina of Time quiz answers</h1>
    <SearchApp client:load entries={entries} languages={languages} initialQuery={q} initialLang={initialLang} />
  </div>
</Base>
