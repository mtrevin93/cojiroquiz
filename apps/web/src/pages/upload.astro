---
import UploadApp from '../components/UploadApp.tsx';
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env.ts';

const env = getEnv();
---

<Base
  title="Upload a quiz question"
  description="Add a quiz question: upload a screenshot or type it in."
  noindex
>
  <div class="wrap narrow">
    <div class="page-head" style="padding-bottom:0">
      <h1>Add a question</h1>
      <p class="muted" style="margin:0">
        Upload a screenshot of the question. The result screen is best.
      </p>
    </div>
    <UploadApp client:load turnstileSiteKey={env.turnstileSiteKey} />
    <noscript><div class="notice error"><p>Uploading needs JavaScript turned on.</p></div></noscript>
  </div>
</Base>
