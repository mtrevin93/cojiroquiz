---
import { buildSearchIndex, questionsWithMarkedChoicePictures } from '@cojiro/db';
import PracticeApp from '../components/PracticeApp.tsx';
import Base from '../layouts/Base.astro';
import { pageContext, pickInitialLang } from '../lib/page.ts';
import { SECONDS_PER_QUESTION, toPracticeQuestions } from '../lib/practice.ts';

const { db, urlFor } = await pageContext();
// Picture choices cropped from a result screenshot show the game's check mark, so they are left out.
const marked = questionsWithMarkedChoicePictures(db);
const questions = toPracticeQuestions(buildSearchIndex(db, urlFor).filter((e) => !marked.has(e.id)));

// Languages that have questions, most questions first. A round stays in one language.
const counts = new Map<string, number>();
for (const q of questions) counts.set(q.lang, (counts.get(q.lang) ?? 0) + 1);
const languages = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([l]) => l);
const initialLang =
  pickInitialLang(Astro.url.searchParams.get('lang'), Astro.request.headers.get('accept-language'), languages) ||
  languages[0] ||
  'en';

Astro.response.headers.set('Vary', 'Accept-Language');
---

<Base
  title="Practice the Ocarina of Time Quiz"
  description={`Practice the Ocarina of Time Quiz from Zelda Notes: 10 questions, 20 questions or endless, ${SECONDS_PER_QUESTION} seconds each.`}
  canonicalPath="/practice"
>
  <div class="wrap">
    <PracticeApp
      client:load
      questions={questions}
      languages={languages}
      initialLang={initialLang}
      seconds={SECONDS_PER_QUESTION}
    />
  </div>
</Base>
