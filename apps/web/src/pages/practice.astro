---
import { buildSearchIndex, listLanguages, questionsWithMarkedChoicePictures, regionalRepeatIds } from '@cojiro/db';
import PracticeApp from '../components/PracticeApp.tsx';
import Base from '../layouts/Base.astro';
import { LANG_COOKIE, pageContext, pickInitialLang } from '../lib/page.ts';
import { SECONDS_PER_QUESTION, toPracticeQuestions } from '../lib/practice.ts';

const { db, urlFor } = await pageContext();
// Picture choices cropped from a result screenshot show the game's check mark, so they are left out.
const marked = questionsWithMarkedChoicePictures(db);
// A round stays in one language, and only that language's questions are sent.
const languages = listLanguages(db).map((l) => l.value);
const initialLang = pickInitialLang(Astro.url.searchParams.get('lang'), Astro.cookies.get(LANG_COOKIE)?.value ?? null, languages);
// The same question in a second regional wording would be asked twice.
const repeats = regionalRepeatIds(db, initialLang);
const questions = toPracticeQuestions(
  buildSearchIndex(db, urlFor, { lang: initialLang }).filter((e) => !marked.has(e.id) && !repeats.has(e.id)),
);

Astro.response.headers.set('Vary', 'Cookie');
---

<Base
  title="Practice the Ocarina of Time Quiz"
  description={`Practice the Ocarina of Time Quiz from Zelda Notes: 10 questions, 20 questions or endless, ${SECONDS_PER_QUESTION} seconds each.`}
  canonicalPath="/practice"
>
  <div class="wrap">
    <PracticeApp
      client:load
      questions={questions}
      initialLang={initialLang}
      seconds={SECONDS_PER_QUESTION}
    />
  </div>
</Base>
