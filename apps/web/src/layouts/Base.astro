---
import '@fontsource-variable/noto-sans/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/global.css';
import FeedbackButton from '../components/FeedbackButton.tsx';
import { getEnv } from '../lib/env.ts';
import { safeJsonLd } from '../lib/security.ts';
import { HOME_TITLE, SITE_DESCRIPTION, SITE_NAME } from '../lib/seo.ts';

interface Props {
  title?: string;
  description?: string;
  /** Path (with leading slash) of the canonical URL; defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Absolute or site-relative image URL for Open Graph. */
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
}

const env = getEnv();
const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  ogImage = null,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : HOME_TITLE;
const canonical = env.siteUrl + canonicalPath;
const absolute = (u: string) => (/^https?:\/\//.test(u) ? u : env.siteUrl + u);
const image = absolute(ogImage ?? '/og.png');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#3a2b1d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={safeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${SITE_NAME} home`}>
          <svg class="mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <defs><linearGradient id="mk" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f1d27f"></stop><stop offset="1" stop-color="#b98a2f"></stop></linearGradient></defs>
            <rect x="1" y="1" width="32" height="32" rx="10" fill="#1a130c" stroke="url(#mk)" stroke-opacity=".55"></rect>
            <path d="M26 7.5C16.5 8 10.2 13.4 9.4 22l-2.6 5.2 1.7.9 2.6-5.1c8.6-.4 14-6 14.9-15.500Z" fill="url(#mk)"></path>
            <path d="M11.300 21.700 21.500 11.500M14.200 18.800l4.800.2M16.800 16.200l4.200.200" fill="none" stroke="#1a130c" stroke-width="1.2" stroke-linecap="round"></path>
          </svg>
          <span>Cojiro <em>Quiz</em></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a class="nav-optional" href="/" aria-current={path === '/' ? 'page' : undefined}>Search</a>
          <a class="nav-optional" href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
          <a class="btn small" href="/upload" aria-current={path === '/upload' ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M6 10l6-6 6 6M4 20h16"></path></svg>
            Upload
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-links">
          <a href="/">Search</a>
          <a href="/upload">Upload</a>
          <a href="/about">About</a>
          <FeedbackButton client:idle turnstileSiteKey={env.turnstileSiteKey} />
        </div>
        <p>
          Answers to the Ocarina of Time Quiz in Zelda Notes. Unofficial fan site, not affiliated with Nintendo. Answers
          are crowdsourced and may be wrong.
        </p>
      </div>
    </footer>
  </body>
</html>
