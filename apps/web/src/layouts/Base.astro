---
import '@fontsource-variable/noto-sans/wght.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cinzel/900.css';
import '../styles/global.css';
import FeedbackButton from '../components/FeedbackButton.tsx';
import { listLanguages } from '@cojiro/db';
import { getEnv } from '../lib/env.ts';
import { LANG_COOKIE, pickInitialLang, sortLanguages } from '../lib/page-lang.ts';
import { getDb } from '../lib/services.ts';
import { langName } from '../lib/text.ts';
import { safeJsonLd } from '../lib/security.ts';
import { HOME_TITLE, SITE_DESCRIPTION, SITE_NAME } from '../lib/seo.ts';

interface Props {
  title?: string;
  description?: string;
  /** Path (with leading slash) of the canonical URL; defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Absolute or site-relative image URL for Open Graph. */
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
}

const env = getEnv();
const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  ogImage = null,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

// Language picker in the header. Each language is its own page load.
const languages = sortLanguages(listLanguages(getDb()).map((l) => l.value));
const currentLang = pickInitialLang(Astro.url.searchParams.get('lang'), Astro.cookies.get(LANG_COOKIE)?.value ?? null, languages);

const fullTitle = title ? `${title} | ${SITE_NAME}` : HOME_TITLE;
const canonical = env.siteUrl + canonicalPath;
const absolute = (u: string) => (/^https?:\/\//.test(u) ? u : env.siteUrl + u);
const image = absolute(ogImage ?? '/og.png');
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0d1640" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={safeJsonLd(data)} />)}
      <script is:inline>
      // A picture that fails to load is tried again twice before it is left blank.
      document.addEventListener(
        'error',
        function (e) {
          var img = e.target;
          if (!img || img.tagName !== 'IMG' || img.hasAttribute('data-noretry')) return;
          var n = Number(img.dataset.retry || 0);
          var base = img.dataset.src || img.currentSrc || img.src;
          if (!/^https?:/.test(base)) return;
          if (n >= 2) return img.classList.add('img-failed');
          img.dataset.src = base;
          img.dataset.retry = String(n + 1);
          setTimeout(function () {
            img.src = base + (base.indexOf('?') < 0 ? '?' : '&') + 'r=' + (n + 1);
          }, n === 0 ? 600 : 1500);
        },
        true,
      );
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${SITE_NAME} home`}>
          <img class="mark" src="/mark.png" alt="" width="40" height="40" />
          <span>Cojiro <em>Quiz</em></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a class="nav-optional" href="/" aria-current={path === '/' ? 'page' : undefined}>Search</a>
          <a class="nav-optional" href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
          <a class="btn small secondary" href="/practice" aria-current={path === '/practice' ? 'page' : undefined}>Practice</a>
          <a class="btn small" href="/upload" aria-current={path === '/upload' ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M6 10l6-6 6 6M4 20h16"></path></svg>
            Upload
          </a>
          {languages.length > 1 && (
            <label class="lang-pick" title="Language">
              <span class="sr-only">Language</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.200-3.8 9c-2.5-2.800-3.800-5.800-3.800-9S9.500 5.800 12 3z"></path></svg>
              <span class="lang-pick-code" aria-hidden="true">{currentLang.split('-').pop()}</span>
              <select id="site-lang" data-cookie={LANG_COOKIE}>
                {languages.map((l) => <option value={l} selected={l === currentLang}>{langName(l)}</option>)}
              </select>
            </label>
          )}
        </nav>
      </div>
    </header>
    <script is:inline>
      (() => {
        const pick = document.getElementById('site-lang');
        if (!pick) return;
        pick.addEventListener('change', () => {
          document.cookie = `${pick.dataset.cookie}=${encodeURIComponent(pick.value)}; path=/; max-age=31536000; samesite=lax`;
          // Search and practice stay where they are in the new language; other pages go to search.
          const here = location.pathname;
          if (here === '/' || here === '/practice') {
            const url = new URL(location.href);
            url.searchParams.delete('lang');
            location.assign(url.pathname + url.search);
          } else location.assign('/');
        });
      })();
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-links">
          <a href="/">Search</a>
          <a href="/practice">Practice</a>
          <a href="/upload">Upload</a>
          <a href="/about">About</a>
          <FeedbackButton client:idle turnstileSiteKey={env.turnstileSiteKey} />
        </div>
        <p>
          Answers to the Ocarina of Time Quiz in Zelda Notes. Unofficial fan site, not affiliated with Nintendo. Answers
          are crowdsourced and may be wrong.
        </p>
      </div>
    </footer>
  </body>
</html>
